generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  userId      String   @unique
  email       String   @unique
  createdAt   DateTime @default(now())
  account     Account?
  bets        Bet[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   BigInt   @default(0) // 1円を1/100で表す

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//競技種目
model Sport {
  id      String   @id
  name    String
  leagues League[]
}

//リーグ
model League {
  id      String  @id
  name    String
  sportId String
  sport   Sport   @relation(fields: [sportId], references: [id])
  events  Event[]
  @@index([sportId])
}

//試合
model Event {
  id              String      @id
  name            String
  leagueId        String
  league          League      @relation(fields: [leagueId], references: [id])
  status          EventStatus @default(SCHEDULED)
  statusUpdatedAt DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())
  endedAt         DateTime?
  startTime       DateTime
  markets         Market[]
  score           Score?
  @@index([leagueId])
  @@index([startTime])
  @@index([status])
}

model Score {
  id        String   @id @default(cuid())
  eventId   String   @unique
  homeScore Int
  awayScore Int
  updatedAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Market {
  id         String     @id
  eventId    String
  marketType MarketType
  line       Decimal    @default(0) @db.Decimal(6, 2)
  event      Event      @relation(fields: [eventId], references: [id])
  odds       Odd[]
  @@unique([eventId, marketType, line]) // TOTAL/SPREADで複数ラインを扱えるようにする
  @@index([eventId])
  @@index([eventId, marketType])
}

model Odd {
  id       String  @id @default(cuid())
  marketId String
  name     String  // "Arsenal", "Draw", "Over", "Under" など
  value    Decimal @db.Decimal(10, 2)
  bets     Bet[]
  market   Market  @relation(fields: [marketId], references: [id])
  @@unique([marketId, name])
  @@index([marketId])
}


model Bet {
  id        String   @id @default(cuid())
  userId    String
  oddId     String
  amount    BigInt
  outcome   Outcome  @default(PENDING)
  createdAt DateTime @default(now())
  odd       Odd      @relation(fields: [oddId], references: [id])
  user      User     @relation(fields: [userId], references: [userId])
}

enum Outcome {
  PENDING
  WON
  LOST
  VOID
}

enum MarketType {
  H2H
  TOTALS
  SPREADS
}

enum EventStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELED
}
